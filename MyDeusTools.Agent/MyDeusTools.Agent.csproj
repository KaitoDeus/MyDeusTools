<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyDeusTools.Agent</AssemblyName>
    <RootNamespace>MyDeusTools.Agent</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>KaitoDeus, Claude</Authors>

    <!-- Single-file publish support for standalone distribution -->
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyDeusTools.Tests" />
  </ItemGroup>

</Project>
