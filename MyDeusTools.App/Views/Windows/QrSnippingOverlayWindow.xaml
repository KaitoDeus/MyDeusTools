<Window x:Class="MyDeusTools.App.Views.Windows.QrSnippingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Snipping Overlay" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#22000000" 
        Topmost="True" 
        ShowInTaskbar="False" 
        Cursor="Cross"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="MainCanvas">
        <!-- Instruction Banner -->
        <Border Background="#DD000000" 
                CornerRadius="8" 
                Padding="20,12" 
                Canvas.Top="30" 
                Canvas.Left="30" 
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Kéo chuột để chọn vùng chứa mã QR cần quét" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"/>
                <TextBlock Text="Thả chuột để giải mã • Nhấn ESC để hủy" 
                           Foreground="#AAAAAA" 
                           FontSize="12" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Selection Rectangle -->
        <Rectangle x:Name="SelectionRect" 
                   Stroke="#0078D4" 
                   StrokeThickness="2" 
                   Fill="#330078D4" 
                   StrokeDashArray="4 2" 
                   Visibility="Collapsed"/>
    </Canvas>
</Window>
