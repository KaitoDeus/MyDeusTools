<Window x:Class="MyDeusTools.App.Views.Windows.ColorPickerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Picker Overlay" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#01000000" 
        Topmost="True" 
        ShowInTaskbar="False" 
        Cursor="Cross"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="MainCanvas">
        <!-- Floating Magnifier HUD -->
        <Border x:Name="MagnifierBorder" 
                Background="#EE1E1E1E" 
                BorderBrush="#44FFFFFF" 
                BorderThickness="1" 
                CornerRadius="10" 
                Padding="8" 
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical">
                <!-- Zoomed Pixel Grid with Center Marker -->
                <Grid Width="100" Height="100" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <Border CornerRadius="6" ClipToBounds="True" BorderBrush="#66FFFFFF" BorderThickness="1">
                        <Image x:Name="MagnifierImage" 
                               Stretch="Fill" 
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- Center Pixel Reticle Box -->
                    <Rectangle Width="10" Height="10" 
                               Stroke="Red" 
                               StrokeThickness="1.5" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Color Swatch & Value Labels -->
                <Grid Width="100">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ColorSwatch" 
                            Grid.Column="0" 
                            Width="20" Height="20" 
                            CornerRadius="4" 
                            BorderBrush="#88FFFFFF" 
                            BorderThickness="1" 
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HexText" 
                                   Text="#FFFFFF" 
                                   Foreground="White" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   FontFamily="Consolas"/>
                        <TextBlock x:Name="RgbText" 
                                   Text="255, 255, 255" 
                                   Foreground="#AAAAAA" 
                                   FontSize="9" 
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Help Banner at top-left -->
        <Border Background="#DD000000" 
                CornerRadius="8" 
                Padding="16,10" 
                Canvas.Top="25" 
                Canvas.Left="25" 
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{DynamicResource Color_OverlayHelp}" 
                           Foreground="White" 
                           FontSize="14" 
                           FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Color_OverlaySub}" 
                           Foreground="#AAAAAA" 
                           FontSize="11" 
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
