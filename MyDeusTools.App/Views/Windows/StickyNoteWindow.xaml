<Window x:Class="MyDeusTools.App.Views.Windows.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Note" 
        Width="260" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TitleBar for dragging -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="10,0">
                    <TextBlock Text="📌 Pinned Note" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:Button HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="4"
                               Appearance="Transparent"
                               Click="OnCloseClick">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="12"/>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- Content Editor -->
            <TextBox Grid.Row="1"
                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="15"
                     FontSize="14"
                     VerticalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
