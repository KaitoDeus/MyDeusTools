<Window x:Class="MyDeusTools.App.Views.Windows.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording Overlay" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#01000000" 
        Topmost="True" 
        ShowInTaskbar="False" 
        Cursor="Cross"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="MainCanvas">
        <Border x:Name="TooltipBorder" 
                Background="#CC000000" 
                CornerRadius="4" 
                Padding="8,4" 
                IsHitTestVisible="False">
            <TextBlock x:Name="CoordsText" 
                       Foreground="White" 
                       FontWeight="SemiBold" 
                       FontSize="14"/>
        </Border>
        
        <Border Background="#CC000000" 
                CornerRadius="8" 
                Padding="16,10" 
                Canvas.Top="20" 
                Canvas.Left="20" 
                IsHitTestVisible="False">
            <TextBlock x:Name="InstructionText" 
                       Text="Click chuột để ghi điểm. Nhấn ENTER/ESC để hoàn tất." 
                       Foreground="White" 
                       FontSize="16" 
                       FontWeight="Bold"/>
        </Border>
    </Canvas>
</Window>
