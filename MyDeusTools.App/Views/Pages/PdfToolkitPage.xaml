<Page x:Class="MyDeusTools.App.Views.Pages.PdfToolkitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:MyDeusTools.App.Services.Impl"
      xmlns:vm="clr-namespace:MyDeusTools.App.ViewModels"
      Title="{DynamicResource Pdf_Title}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent">

    <Grid Margin="35,20,35,20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="{DynamicResource Pdf_Title}" 
                           FontSize="26" 
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="13" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Progress Bar during long operations -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="220">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}" 
                           FontSize="11" 
                           HorizontalAlignment="Right" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
            
            <!-- ================= TAB 1: MERGE PDFS ================= -->
            <TabItem Header="{DynamicResource Pdf_Tab_Merge}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource Pdf_AddPdfFiles}" 
                                       Icon="{ui:SymbolIcon Symbol=Add24}" 
                                       Command="{Binding AddMergeFilesCommand}" 
                                       Appearance="Primary" 
                                       Padding="14,6" 
                                       Margin="0,0,8,0"/>
                            <ui:Button Content="{DynamicResource Pdf_ClearList}" 
                                       Icon="{ui:SymbolIcon Symbol=Delete24}" 
                                       Command="{Binding ClearMergeFilesCommand}" 
                                       Appearance="Secondary" 
                                       Padding="12,6"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Pdf_Subtitle}" 
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Center" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <!-- Items Queue -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            AllowDrop="True" 
                            Drop="OnMergeDrop" 
                            DragOver="OnDragOver"
                            Margin="0,0,0,14">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MergeFiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="44" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource Pdf_EmptyMergeTitle}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Pdf_EmptyMergeDesc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Items List -->
                            <ListView ItemsSource="{Binding MergeFiles}" Background="Transparent" BorderThickness="0" Padding="8">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PdfMergeItemViewModel}">
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="12,8" 
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Index & Icon -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding OrderNumber, StringFormat='#{0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="20" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                </StackPanel>

                                                <!-- File details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Badges: Pages & Size -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0} p'}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Reorder / Remove Actions -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowUp24}" 
                                                               Command="{Binding DataContext.MoveMergeItemUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                               CommandParameter="{Binding}" 
                                                               Appearance="Transparent" 
                                                               ToolTip="{DynamicResource Pdf_TooltipMoveUp}"
                                                               Padding="4" Margin="0,0,2,0"/>
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowDown24}" 
                                                               Command="{Binding DataContext.MoveMergeItemDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                               CommandParameter="{Binding}" 
                                                               Appearance="Transparent" 
                                                               ToolTip="{DynamicResource Pdf_TooltipMoveDown}"
                                                               Padding="4" Margin="0,0,4,0"/>
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}" 
                                                               Command="{Binding DataContext.RemoveMergeItemCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                               CommandParameter="{Binding}" 
                                                               Appearance="Transparent" 
                                                               ToolTip="{DynamicResource Pdf_TooltipRemove}"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               Padding="4"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Bottom Output Settings & Action Card -->
                    <ui:Card Grid.Row="2" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Pdf_OutputFileName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding MergeOutputFileName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Pdf_OutputDirectory}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MergeOutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Padding="6,4"/>
                                    <ui:Button Grid.Column="1" Content="{DynamicResource Pdf_Browse}" Command="{Binding SelectMergeOutputDirectoryCommand}" Appearance="Secondary" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <ui:Button Content="{DynamicResource Pdf_BtnStartMerge}" 
                                           Icon="{ui:SymbolIcon Symbol=DocumentMultiple24}" 
                                           Command="{Binding StartMergeCommand}" 
                                           Appearance="Primary" 
                                           Padding="16,8" 
                                           Margin="0,0,8,0"/>

                                <ui:Button Content="{DynamicResource Pdf_BtnOpenFolder}" 
                                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}" 
                                           Command="{Binding OpenMergeOutputFolderCommand}" 
                                           Appearance="Secondary" 
                                           Padding="12,8"
                                           Margin="0,0,6,0">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMergedResult}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                                <ui:Button Content="{DynamicResource Pdf_BtnOpenFile}" 
                                           Icon="{ui:SymbolIcon Symbol=ArrowUpRight24}" 
                                           Command="{Binding OpenMergeOutputFileCommand}" 
                                           Appearance="Secondary" 
                                           Padding="12,8">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMergedResult}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: SPLIT PDF ================= -->
            <TabItem Header="{DynamicResource Pdf_Tab_Split}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        
                        <!-- Source File Card -->
                        <ui:Card Padding="16" Margin="0,0,0,16" AllowDrop="True" Drop="OnSplitDrop" DragOver="OnDragOver">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Pdf_SourceFileInfoHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SplitSourceInfo.FileName, FallbackValue='Chưa chọn tệp PDF'}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding SplitSourceFilePath, FallbackValue='Kéo thả tệp PDF vào đây hoặc nhấn Chọn tệp...'}" 
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,6"/>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SplitSourceInfo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SplitSourceInfo.PageCount, StringFormat='{}Tổng: {0} trang'}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding SplitSourceInfo.FileSizeFormatted}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <ui:Button Grid.Column="1" 
                                           Content="{DynamicResource Pdf_SelectSplitSourceBtn}" 
                                           Icon="{ui:SymbolIcon Symbol=DocumentPdf24}" 
                                           Command="{Binding SelectSplitSourceFileCommand}" 
                                           Appearance="Primary" 
                                           VerticalAlignment="Center" 
                                           Padding="14,8"/>
                            </Grid>
                        </ui:Card>

                        <!-- Split Configuration Card -->
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Pdf_SplitOptionsHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

                                <!-- Mode 1: Range -->
                                <RadioButton GroupName="SplitMode" 
                                             IsChecked="{Binding SelectedSplitMode, ConverterParameter={x:Static models:PdfSplitMode.PageRange}, Converter={x:Null}}" 
                                             Content="{DynamicResource Pdf_SplitMode_Range}" 
                                             FontWeight="SemiBold" 
                                             Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Pdf_SplitMode_RangeDesc}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="24,0,0,8"/>
                                <StackPanel Margin="24,0,0,14">
                                    <TextBlock Text="{DynamicResource Pdf_SplitRangeLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SplitPageRange, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" Padding="6,4"/>
                                </StackPanel>

                                <Separator Margin="0,4,0,12"/>

                                <!-- Mode 2: Single Pages -->
                                <RadioButton GroupName="SplitMode" 
                                             IsChecked="{Binding SelectedSplitMode, ConverterParameter={x:Static models:PdfSplitMode.SinglePages}, Converter={x:Null}}" 
                                             Content="{DynamicResource Pdf_SplitMode_Single}" 
                                             FontWeight="SemiBold" 
                                             Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Pdf_SplitMode_SingleDesc}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="24,0,0,14"/>

                                <Separator Margin="0,4,0,12"/>

                                <!-- Mode 3: Every N Pages -->
                                <RadioButton GroupName="SplitMode" 
                                             IsChecked="{Binding SelectedSplitMode, ConverterParameter={x:Static models:PdfSplitMode.EveryNPages}, Converter={x:Null}}" 
                                             Content="{DynamicResource Pdf_SplitMode_EveryN}" 
                                             FontWeight="SemiBold" 
                                             Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Pdf_SplitMode_EveryNDesc}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="24,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                                    <TextBlock Text="{DynamicResource Pdf_SplitEveryNLabel}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SplitEveryN, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Destination & Actions -->
                        <ui:Card Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Pdf_SplitBaseNameLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SplitBaseFileName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Pdf_OutputDirectory}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SplitOutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Padding="6,4"/>
                                        <ui:Button Grid.Column="1" Content="{DynamicResource Pdf_Browse}" Command="{Binding SelectSplitOutputDirectoryCommand}" Appearance="Secondary" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ui:Button Content="{DynamicResource Pdf_BtnStartSplit}" 
                                               Icon="{ui:SymbolIcon Symbol=ArrowSplit24}" 
                                               Command="{Binding StartSplitCommand}" 
                                               Appearance="Primary" 
                                               Padding="16,8" 
                                               Margin="0,0,8,0"/>

                                    <ui:Button Content="{DynamicResource Pdf_BtnOpenFolder}" 
                                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}" 
                                               Command="{Binding OpenSplitOutputFolderCommand}" 
                                               Appearance="Secondary" 
                                               Padding="12,8">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSplitResult}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= TAB 3: IMAGES TO PDF ================= -->
            <TabItem Header="{DynamicResource Pdf_Tab_ImagesToPdf}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{DynamicResource Pdf_AddImages}" 
                                       Icon="{ui:SymbolIcon Symbol=Add24}" 
                                       Command="{Binding AddImagesCommand}" 
                                       Appearance="Primary" 
                                       Padding="14,6" 
                                       Margin="0,0,8,0"/>
                            <ui:Button Content="{DynamicResource Pdf_ClearImages}" 
                                       Icon="{ui:SymbolIcon Symbol=Delete24}" 
                                       Command="{Binding ClearImagesCommand}" 
                                       Appearance="Secondary" 
                                       Padding="12,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Images Queue -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            AllowDrop="True" 
                            Drop="OnImagesDrop" 
                            DragOver="OnDragOver"
                            Margin="0,0,0,14">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImageFiles.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="44" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="{DynamicResource Pdf_EmptyImagesTitle}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Pdf_EmptyImagesDesc}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Items List -->
                            <ListView ItemsSource="{Binding ImageFiles}" Background="Transparent" BorderThickness="0" Padding="8">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ImageToPdfItemViewModel}">
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="12,8" 
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Index & Icon -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding OrderNumber, StringFormat='#{0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    </Border>
                                                    <ui:SymbolIcon Symbol="Image24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- File details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Size -->
                                                <TextBlock Grid.Column="2" Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowUp24}" 
                                                               Command="{Binding DataContext.MoveImageItemUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                               CommandParameter="{Binding}" 
                                                               Appearance="Transparent" 
                                                               ToolTip="{DynamicResource Pdf_TooltipMoveUp}"
                                                               Padding="4" Margin="0,0,2,0"/>
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowDown24}" 
                                                               Command="{Binding DataContext.MoveImageItemDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                               CommandParameter="{Binding}" 
                                                               Appearance="Transparent" 
                                                               ToolTip="{DynamicResource Pdf_TooltipMoveDown}"
                                                               Padding="4" Margin="0,0,4,0"/>
                                                    <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}" 
                                                               Command="{Binding DataContext.RemoveImageItemCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                                                               CommandParameter="{Binding}" 
                                                               Appearance="Transparent" 
                                                               ToolTip="{DynamicResource Pdf_TooltipRemove}"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               Padding="4"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Bottom Settings & Actions Card -->
                    <ui:Card Grid.Row="2" Padding="14">
                        <StackPanel>
                            <!-- Options Row -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource Pdf_PageSizeLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding SelectedPageSize, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{DynamicResource Pdf_PageSize_A4}"/>
                                        <ComboBoxItem Content="{DynamicResource Pdf_PageSize_Letter}"/>
                                        <ComboBoxItem Content="{DynamicResource Pdf_PageSize_Fit}"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="{DynamicResource Pdf_OrientationLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding SelectedOrientation, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{DynamicResource Pdf_Orientation_Auto}"/>
                                        <ComboBoxItem Content="{DynamicResource Pdf_Orientation_Portrait}"/>
                                        <ComboBoxItem Content="{DynamicResource Pdf_Orientation_Landscape}"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Pdf_MarginLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding SelectedMargin, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{DynamicResource Pdf_Margin_None}"/>
                                        <ComboBoxItem Content="{DynamicResource Pdf_Margin_Small}"/>
                                        <ComboBoxItem Content="{DynamicResource Pdf_Margin_Normal}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Destination & Execute Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Pdf_OutputFileName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ImagesPdfOutputFileName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Pdf_OutputDirectory}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ImagesPdfOutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Padding="6,4"/>
                                        <ui:Button Grid.Column="1" Content="{DynamicResource Pdf_Browse}" Command="{Binding SelectImagesPdfOutputDirectoryCommand}" Appearance="Secondary" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ui:Button Content="{DynamicResource Pdf_BtnStartImagesPdf}" 
                                               Icon="{ui:SymbolIcon Symbol=DocumentPdf24}" 
                                               Command="{Binding StartImagesToPdfCommand}" 
                                               Appearance="Primary" 
                                               Padding="16,8" 
                                               Margin="0,0,8,0"/>

                                    <ui:Button Content="{DynamicResource Pdf_BtnOpenFolder}" 
                                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}" 
                                               Command="{Binding OpenImagesPdfOutputFolderCommand}" 
                                               Appearance="Secondary" 
                                               Padding="12,8"
                                               Margin="0,0,6,0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImagesPdfResult}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Content="{DynamicResource Pdf_BtnOpenFile}" 
                                               Icon="{ui:SymbolIcon Symbol=ArrowUpRight24}" 
                                               Command="{Binding OpenImagesPdfOutputFileCommand}" 
                                               Appearance="Secondary" 
                                               Padding="12,8">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImagesPdfResult}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: PROTECT & METADATA ================= -->
            <TabItem Header="{DynamicResource Pdf_Tab_Protect}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        
                        <!-- Source File Card -->
                        <ui:Card Padding="16" Margin="0,0,0,16" AllowDrop="True" Drop="OnProtectDrop" DragOver="OnDragOver">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Pdf_SourceFileInfoHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding ProtectSourceInfo.FileName, FallbackValue='Chưa chọn tệp PDF'}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding ProtectSourceFilePath, FallbackValue='Kéo thả tệp PDF vào đây hoặc nhấn Chọn tệp...'}" 
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,6"/>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProtectSourceInfo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ProtectSourceInfo.PageCount, StringFormat='{}Tổng: {0} trang'}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="{Binding ProtectSourceInfo.FileSizeFormatted}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <ui:Button Grid.Column="1" 
                                           Content="{DynamicResource Pdf_SelectProtectSourceBtn}" 
                                           Icon="{ui:SymbolIcon Symbol=DocumentPdf24}" 
                                           Command="{Binding SelectProtectSourceFileCommand}" 
                                           Appearance="Primary" 
                                           VerticalAlignment="Center" 
                                           Padding="14,8"/>
                            </Grid>
                        </ui:Card>

                        <!-- Security Password Card -->
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Pdf_SecurityHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Pdf_UserPasswordLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ProtectUserPassword, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        <TextBlock Text="{DynamicResource Pdf_UserPasswordPrompt}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Pdf_OwnerPasswordLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ProtectOwnerPassword, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Metadata Properties Card -->
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Pdf_MetadataHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Pdf_MetaTitle}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ProtectTitle, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Pdf_MetaAuthor}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ProtectAuthor, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{DynamicResource Pdf_MetaSubject}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ProtectSubject, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Pdf_MetaKeywords}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ProtectKeywords, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Destination & Actions -->
                        <ui:Card Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Pdf_OutputFileName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ProtectOutputFileName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Pdf_OutputDirectory}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ProtectOutputDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Padding="6,4"/>
                                        <ui:Button Grid.Column="1" Content="{DynamicResource Pdf_Browse}" Command="{Binding SelectProtectOutputDirectoryCommand}" Appearance="Secondary" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ui:Button Content="{DynamicResource Pdf_BtnStartProtect}" 
                                               Icon="{ui:SymbolIcon Symbol=LockClosed24}" 
                                               Command="{Binding StartProtectCommand}" 
                                               Appearance="Primary" 
                                               Padding="16,8" 
                                               Margin="0,0,8,0"/>

                                    <ui:Button Content="{DynamicResource Pdf_BtnOpenFolder}" 
                                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}" 
                                               Command="{Binding OpenProtectOutputFolderCommand}" 
                                               Appearance="Secondary" 
                                               Padding="12,8"
                                               Margin="0,0,6,0">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProtectedPdfResult}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Content="{DynamicResource Pdf_BtnOpenFile}" 
                                               Icon="{ui:SymbolIcon Symbol=ArrowUpRight24}" 
                                               Command="{Binding OpenProtectOutputFileCommand}" 
                                               Appearance="Secondary" 
                                               Padding="12,8">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasProtectedPdfResult}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
