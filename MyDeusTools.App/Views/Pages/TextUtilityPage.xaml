<Page x:Class="MyDeusTools.App.Views.Pages.TextUtilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Text &amp; Dev Tools"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent">

    <Grid Margin="30,20,30,20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{DynamicResource TextDev_Title}" 
                           FontSize="26" 
                           FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource TextDev_Subtitle}" 
                           FontSize="13" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Navigation Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton x:Name="BtnTabJson" 
                         GroupName="TextUtilTabs"
                         Content="{DynamicResource TextDev_Tab_Json}" 
                         Style="{StaticResource {x:Type ToggleButton}}" 
                         IsChecked="True" 
                         Margin="0,0,8,0" 
                         Padding="16,7"/>

            <RadioButton x:Name="BtnTabBase64" 
                         GroupName="TextUtilTabs"
                         Content="{DynamicResource TextDev_Tab_Base64}" 
                         Style="{StaticResource {x:Type ToggleButton}}" 
                         Margin="0,0,8,0" 
                         Padding="16,7"/>

            <RadioButton x:Name="BtnTabUrl" 
                         GroupName="TextUtilTabs"
                         Content="{DynamicResource TextDev_Tab_Url}" 
                         Style="{StaticResource {x:Type ToggleButton}}" 
                         Margin="0,0,8,0" 
                         Padding="16,7"/>

            <RadioButton x:Name="BtnTabHash" 
                         GroupName="TextUtilTabs"
                         Content="{DynamicResource TextDev_Tab_Hash}" 
                         Style="{StaticResource {x:Type ToggleButton}}" 
                         Margin="0,0,8,0" 
                         Padding="16,7"/>

            <RadioButton x:Name="BtnTabInspector" 
                         GroupName="TextUtilTabs"
                         Content="{DynamicResource TextDev_Tab_Inspector}" 
                         Style="{StaticResource {x:Type ToggleButton}}" 
                         Padding="16,7"/>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">

            <!-- ==================== TAB 1: JSON STUDIO ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnTabJson}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Orientation="Vertical">
                    <!-- Action Bar & Status -->
                    <ui:Card Margin="0,0,0,12" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Command="{Binding FormatJsonCommand}" 
                                           Appearance="Primary" 
                                           Margin="0,0,8,0" 
                                           Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Code24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_Format}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding MinifyJsonCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowMinimize24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_Minify}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding ValidateJsonCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_Validate}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding SwapJsonCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="12,6" 
                                           ToolTip="{DynamicResource TextDev_Swap}">
                                    <ui:SymbolIcon Symbol="ArrowSwap24"/>
                                </ui:Button>

                                <ui:Button Command="{Binding ClearJsonCommand}" 
                                           Padding="12,6" 
                                           ToolTip="{DynamicResource TextDev_Clear}">
                                    <ui:SymbolIcon Symbol="Delete24"/>
                                </ui:Button>
                            </StackPanel>

                            <!-- Status text -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding JsonStatus}" 
                                       VerticalAlignment="Center" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Dual Editor Columns -->
                    <Grid MinHeight="440" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Input -->
                        <ui:Card Grid.Column="0" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource TextDev_JsonInput}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Command="{Binding PasteJsonInputCommand}" 
                                                   Padding="8,4" 
                                                   FontSize="11" 
                                                   Content="{DynamicResource TextDev_PasteClipboard}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         MinHeight="380"
                                         Text="{Binding JsonInput, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         Padding="8"/>
                            </Grid>
                        </ui:Card>

                        <!-- Right: Output -->
                        <ui:Card Grid.Column="2" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource TextDev_JsonOutput}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Command="{Binding CopyJsonOutputCommand}" 
                                                   Padding="8,4" 
                                                   FontSize="11" 
                                                   Appearance="Primary"
                                                   Content="{DynamicResource TextDev_Copy}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         MinHeight="380"
                                         Text="{Binding JsonOutput, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         Padding="8"/>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 2: BASE64 ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnTabBase64}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Orientation="Vertical">
                    <!-- Actions -->
                    <ui:Card Margin="0,0,0,12" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Command="{Binding EncodeBase64Command}" 
                                           Appearance="Primary" 
                                           Margin="0,0,8,0" 
                                           Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_Encode}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding DecodeBase64Command}" 
                                           Margin="0,0,8,0" 
                                           Padding="14,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockOpen24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_Decode}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding EncodeFileBase64Command}" 
                                           Margin="0,0,8,0" 
                                           Padding="12,6" 
                                           ToolTip="{DynamicResource TextDev_EncodeFile}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Document24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_EncodeFile}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding SaveBase64ToFileCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="12,6" 
                                           ToolTip="{DynamicResource TextDev_SaveToFile}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_SaveToFile}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding SwapBase64Command}" 
                                           Margin="0,0,8,0" 
                                           Padding="10,6" 
                                           ToolTip="{DynamicResource TextDev_Swap}">
                                    <ui:SymbolIcon Symbol="ArrowSwap24"/>
                                </ui:Button>

                                <ui:Button Command="{Binding ClearBase64Command}" 
                                           Padding="10,6" 
                                           ToolTip="{DynamicResource TextDev_Clear}">
                                    <ui:SymbolIcon Symbol="Delete24"/>
                                </ui:Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Base64Status}" 
                                       VerticalAlignment="Center" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Dual Editor Columns -->
                    <Grid MinHeight="440" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource TextDev_Base64Input}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding PasteBase64InputCommand}" 
                                               HorizontalAlignment="Right" 
                                               Padding="8,4" 
                                               FontSize="11" 
                                               Content="{DynamicResource TextDev_Paste}"/>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         MinHeight="380"
                                         Text="{Binding Base64Input, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Padding="8"/>
                            </Grid>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource TextDev_Base64Output}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding CopyBase64OutputCommand}" 
                                               HorizontalAlignment="Right" 
                                               Padding="8,4" 
                                               FontSize="11" 
                                               Appearance="Primary" 
                                               Content="{DynamicResource TextDev_Copy}"/>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         MinHeight="380"
                                         Text="{Binding Base64Output, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Padding="8"/>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 3: URL & HTML ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnTabUrl}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Orientation="Vertical">
                    <ui:Card Margin="0,0,0,12" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Command="{Binding UrlEncodeCommand}" 
                                           Appearance="Primary" 
                                           Margin="0,0,8,0" 
                                           Padding="12,6" 
                                           Content="URL Encode"/>

                                <ui:Button Command="{Binding UrlDecodeCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="12,6" 
                                           Content="URL Decode"/>

                                <ui:Button Command="{Binding HtmlEncodeCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="12,6" 
                                           Content="HTML Encode"/>

                                <ui:Button Command="{Binding HtmlDecodeCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="12,6" 
                                           Content="HTML Decode"/>

                                <ui:Button Command="{Binding SwapUrlHtmlCommand}" 
                                           Margin="0,0,8,0" 
                                           Padding="10,6" 
                                           ToolTip="{DynamicResource TextDev_Swap}">
                                    <ui:SymbolIcon Symbol="ArrowSwap24"/>
                                </ui:Button>

                                <ui:Button Command="{Binding ClearUrlHtmlCommand}" 
                                           Padding="10,6" 
                                           ToolTip="{DynamicResource TextDev_ClearShort}">
                                    <ui:SymbolIcon Symbol="Delete24"/>
                                </ui:Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding UrlHtmlStatus}" 
                                       VerticalAlignment="Center" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </ui:Card>

                    <Grid MinHeight="440" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource TextDev_UrlHtmlInput}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding PasteUrlHtmlInputCommand}" 
                                               HorizontalAlignment="Right" 
                                               Padding="8,4" 
                                               FontSize="11" 
                                               Content="{DynamicResource TextDev_Paste}"/>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         MinHeight="380"
                                         Text="{Binding UrlHtmlInput, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Padding="8"/>
                            </Grid>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource TextDev_UrlHtmlOutput}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Command="{Binding CopyUrlHtmlOutputCommand}" 
                                               HorizontalAlignment="Right" 
                                               Padding="8,4" 
                                               FontSize="11" 
                                               Appearance="Primary" 
                                               Content="{DynamicResource TextDev_Copy}"/>
                                </Grid>

                                <TextBox Grid.Row="1"
                                         MinHeight="380"
                                         Text="{Binding UrlHtmlOutput, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="13"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Padding="8"/>
                            </Grid>
                        </ui:Card>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 4: HASH GENERATOR ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnTabHash}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Orientation="Vertical">

                    <!-- Text Input Card -->
                    <ui:Card Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource TextDev_HashStringHeader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ui:Button Command="{Binding ClearHashCommand}" 
                                           HorizontalAlignment="Right" 
                                           Padding="8,4" 
                                           FontSize="11" 
                                           Content="{DynamicResource TextDev_ClearShort}"/>
                            </Grid>

                            <TextBox Text="{Binding HashInput, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="70"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Padding="8"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Text Hashes Grid -->
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TextDev_HashTextHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                            <!-- MD5 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MD5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Md5Hash, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyHashCommand}" CommandParameter="{Binding Md5Hash}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- SHA-1 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SHA-1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Sha1Hash, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyHashCommand}" CommandParameter="{Binding Sha1Hash}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- SHA-256 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SHA-256" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Sha256Hash, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyHashCommand}" CommandParameter="{Binding Sha256Hash}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- SHA-512 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SHA-512" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Sha512Hash, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyHashCommand}" CommandParameter="{Binding Sha512Hash}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- File Hash Section -->
                    <ui:Card Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource TextDev_HashFileHeader}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                <ui:Button Command="{Binding SelectFileForHashCommand}" 
                                           HorizontalAlignment="Right" 
                                           Appearance="Primary" 
                                           Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource TextDev_ChooseFile}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <TextBlock Text="{Binding SelectedHashFile}" 
                                       FontStyle="Italic" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,0,0,10"/>

                            <!-- File MD5 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="File MD5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding FileMd5Hash, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyHashCommand}" CommandParameter="{Binding FileMd5Hash}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- File SHA-256 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="File SHA-256" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding FileSha256Hash, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyHashCommand}" CommandParameter="{Binding FileSha256Hash}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== TAB 5: CASE & INSPECTOR ==================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BtnTabInspector}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Orientation="Vertical">

                    <!-- Text Input Card -->
                    <ui:Card Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource TextDev_InspectorPrompt}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ui:Button Command="{Binding ClearInspectorCommand}" 
                                           HorizontalAlignment="Right" 
                                           Padding="8,4" 
                                           FontSize="11" 
                                           Content="{DynamicResource TextDev_ClearShort}"/>
                            </Grid>

                            <TextBox Text="{Binding InspectorInput, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="70"
                                     AcceptsReturn="True"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     Padding="8"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Statistics Cards -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Padding="12,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource TextDev_StatsChars}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CharacterCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="2" Padding="12,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource TextDev_StatsNoSpaces}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CharactersNoSpacesCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="4" Padding="12,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource TextDev_StatsWords}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding WordCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="6" Padding="12,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource TextDev_StatsLines}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LineCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Grid.Column="8" Padding="12,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Bytes (UTF-8)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ByteCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <!-- Case Transformations Card -->
                    <ui:Card Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TextDev_CaseHeader}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                            <!-- camelCase -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="camelCase" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding CamelCase, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyCaseCommand}" CommandParameter="{Binding CamelCase}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- PascalCase -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PascalCase" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PascalCase, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyCaseCommand}" CommandParameter="{Binding PascalCase}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- snake_case -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="snake_case" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SnakeCase, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyCaseCommand}" CommandParameter="{Binding SnakeCase}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- kebab-case -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="kebab-case" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding KebabCase, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyCaseCommand}" CommandParameter="{Binding KebabCase}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- UPPERCASE -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="UPPERCASE" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding UpperCase, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyCaseCommand}" CommandParameter="{Binding UpperCase}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- lowercase -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="lowercase" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding LowerCase, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyCaseCommand}" CommandParameter="{Binding LowerCase}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>

                            <!-- Title Case -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Title Case" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding TitleCase, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0" Padding="6,4"/>
                                <ui:Button Grid.Column="2" Command="{Binding CopyCaseCommand}" CommandParameter="{Binding TitleCase}" Padding="10,5" Content="{DynamicResource TextDev_Copy}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
