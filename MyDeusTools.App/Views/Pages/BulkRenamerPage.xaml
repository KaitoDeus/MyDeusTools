<Page x:Class="MyDeusTools.App.Views.Pages.BulkRenamerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:impl="clr-namespace:MyDeusTools.App.Services.Impl"
      xmlns:vm="clr-namespace:MyDeusTools.App.ViewModels"
      Title="{DynamicResource Renamer_Title}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent">

    <Page.Resources>
        <impl:RenameStatusToBrushConverter x:Key="StatusBrushConverter"/>
        <impl:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroConverter"/>
        <impl:BooleanInverseConverter x:Key="BoolInverseConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Page.Resources>

    <Grid Margin="30,16,30,16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="{DynamicResource Renamer_Title}" 
                           FontSize="24" 
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Undo Button -->
                <ui:Button Content="{DynamicResource Renamer_Btn_Undo}" 
                           Command="{Binding UndoCommand}"
                           Appearance="Secondary" 
                           Icon="{ui:SymbolIcon Symbol=ArrowUndo24}"
                           IsEnabled="{Binding CanUndo}"
                           Margin="0,0,8,0"/>

                <!-- Clear List Button -->
                <ui:Button Content="{DynamicResource Renamer_Btn_ClearList}" 
                           Command="{Binding ClearListCommand}"
                           Appearance="Transparent" 
                           Icon="{ui:SymbolIcon Symbol=Delete24}"
                           IsEnabled="{Binding HasItems}"/>
            </StackPanel>
        </Grid>

        <!-- ================= MAIN 2-COLUMN LAYOUT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN: RULES & OPTIONS ================= -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource Renamer_RulesTitle}" 
                                       FontWeight="SemiBold" 
                                       FontSize="14" 
                                       Margin="0,0,0,8"/>

                            <!-- RULES TAB CONTROL -->
                            <TabControl Background="Transparent" BorderThickness="0" Padding="0,4,0,0">
                                
                                <!-- TAB 1: FIND & REPLACE -->
                                <TabItem Header="{DynamicResource Renamer_Tab_Replace}">
                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Renamer_FindLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" 
                                                    PlaceholderText="{DynamicResource Renamer_FindPlaceholder}" 
                                                    Margin="0,0,0,8"/>

                                        <TextBlock Text="{DynamicResource Renamer_ReplaceLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" 
                                                    PlaceholderText="{DynamicResource Renamer_ReplacePlaceholder}" 
                                                    Margin="0,0,0,10"/>

                                        <CheckBox Content="{DynamicResource Renamer_MatchCase}" 
                                                  IsChecked="{Binding MatchCase}" 
                                                  Margin="0,0,0,6"/>

                                        <CheckBox Content="{DynamicResource Renamer_UseRegex}" 
                                                  IsChecked="{Binding UseRegex}" 
                                                  Margin="0,0,0,4"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- TAB 2: INSERT & REMOVE -->
                                <TabItem Header="{DynamicResource Renamer_Tab_InsertRemove}">
                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Renamer_PrefixLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" 
                                                    PlaceholderText="{DynamicResource Renamer_PrefixPlaceholder}" 
                                                    Margin="0,0,0,8"/>

                                        <TextBlock Text="{DynamicResource Renamer_SuffixLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" 
                                                    PlaceholderText="{DynamicResource Renamer_SuffixPlaceholder}" 
                                                    Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{DynamicResource Renamer_InsertTextLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ui:TextBox Text="{Binding InsertText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{DynamicResource Renamer_InsertPosLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ui:TextBox Text="{Binding InsertPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Renamer_RemoveFirstLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ui:TextBox Text="{Binding RemoveFirstN, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{DynamicResource Renamer_RemoveLastLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ui:TextBox Text="{Binding RemoveLastN, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox Content="{DynamicResource Renamer_TrimWhitespace}" 
                                                  IsChecked="{Binding TrimWhitespace}" 
                                                  Margin="0,0,0,4"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- TAB 3: CASE CONVERSION -->
                                <TabItem Header="{DynamicResource Renamer_Tab_Case}">
                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                        <TextBlock Text="{DynamicResource Renamer_CaseModeLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding CaseModes}" 
                                                  SelectedItem="{Binding SelectedCaseMode}" 
                                                  HorizontalAlignment="Stretch" 
                                                  Margin="0,0,0,10"/>

                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                                CornerRadius="6" 
                                                Padding="10,8" 
                                                Margin="0,4,0,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{DynamicResource Renamer_CaseExamplesTitle}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="• UPPER: MY_FILE_NAME.TXT" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="• lower: my_file_name.txt" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="• Title Case: My File Name.txt" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="• camelCase: myFileName.txt" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="• PascalCase: MyFileName.txt" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="• snake_case: my_file_name.txt" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="• kebab-case: my-file-name.txt" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </TabItem>

                                <!-- TAB 4: NUMBERING & DATE -->
                                <TabItem Header="{DynamicResource Renamer_Tab_NumberDate}">
                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                        <CheckBox Content="{DynamicResource Renamer_EnableNumbering}" 
                                                  IsChecked="{Binding EnableNumbering}" 
                                                  FontWeight="SemiBold"
                                                  Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Renamer_NumberPlacementLabel}" FontSize="11" Margin="0,0,0,4"/>
                                                <ComboBox ItemsSource="{Binding NumberPlacements}" 
                                                          SelectedItem="{Binding NumberPlacement}" 
                                                          HorizontalAlignment="Stretch"
                                                          IsEnabled="{Binding EnableNumbering}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{DynamicResource Renamer_NumberSepLabel}" FontSize="11" Margin="0,0,0,4"/>
                                                <ui:TextBox Text="{Binding NumberSeparator, UpdateSourceTrigger=PropertyChanged}" 
                                                            IsEnabled="{Binding EnableNumbering}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="{DynamicResource Renamer_StartNumLabel}" FontSize="10" Margin="0,0,0,2"/>
                                                <ui:TextBox Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}" 
                                                            IsEnabled="{Binding EnableNumbering}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                <TextBlock Text="{DynamicResource Renamer_StepLabel}" FontSize="10" Margin="0,0,0,2"/>
                                                <ui:TextBox Text="{Binding NumberStep, UpdateSourceTrigger=PropertyChanged}" 
                                                            IsEnabled="{Binding EnableNumbering}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="{DynamicResource Renamer_ZeroPadLabel}" FontSize="10" Margin="0,0,0,2"/>
                                                <ui:TextBox Text="{Binding ZeroPadding, UpdateSourceTrigger=PropertyChanged}" 
                                                            IsEnabled="{Binding EnableNumbering}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Margin="0,4,0,8"/>

                                        <TextBlock Text="{DynamicResource Renamer_DatePlacementLabel}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding DatePlacements}" 
                                                  SelectedItem="{Binding DatePlacement}" 
                                                  HorizontalAlignment="Stretch" 
                                                  Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="{DynamicResource Renamer_DateSourceLabel}" FontSize="10" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding DateSources}" 
                                                          SelectedItem="{Binding DateSource}" 
                                                          HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{DynamicResource Renamer_DateFormatLabel}" FontSize="10" Margin="0,0,0,2"/>
                                                <ui:TextBox Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <Separator Margin="0,10,0,10"/>

                            <!-- SCOPE & OPTIONS -->
                            <TextBlock Text="{DynamicResource Renamer_OptionsTitle}" 
                                       FontWeight="SemiBold" 
                                       FontSize="12" 
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="{DynamicResource Renamer_TargetTypeLabel}" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding TargetTypes}" 
                                      SelectedItem="{Binding TargetType}" 
                                      HorizontalAlignment="Stretch" 
                                      Margin="0,0,0,8"/>

                            <CheckBox Content="{DynamicResource Renamer_IncludeExtension}" 
                                      IsChecked="{Binding IncludeExtension}" 
                                      Margin="0,0,0,6"/>

                            <CheckBox Content="{DynamicResource Renamer_ScanRecursive}" 
                                      IsChecked="{Binding ScanRecursive}" 
                                      Margin="0,0,0,4"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- BOTTOM ACTIONS -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0"
                                 Value="{Binding ProgressPercentage}" 
                                 Maximum="100" 
                                 Height="4" 
                                 Margin="0,0,0,8"
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisConverter}}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0"
                                   Content="{DynamicResource Renamer_Btn_Apply}" 
                                   Command="{Binding ApplyRenameCommand}"
                                   Appearance="Primary" 
                                   Icon="{ui:SymbolIcon Symbol=Rename24}"
                                   FontSize="13"
                                   Padding="16,8"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding HasReadyItems}"
                                   Visibility="{Binding IsProcessing, Converter={StaticResource BoolInverseConverter}, Mode=OneWay}"/>

                        <ui:Button Grid.Column="0"
                                   Content="{DynamicResource Renamer_Btn_Cancel}" 
                                   Command="{Binding CancelCommand}"
                                   Appearance="Danger" 
                                   Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                   FontSize="13"
                                   Padding="16,8"
                                   HorizontalAlignment="Stretch"
                                   Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= RIGHT COLUMN: PREVIEW TABLE & QUEUE ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DROP ZONE -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,10"
                        AllowDrop="True"
                        DragOver="DropZoneBorder_DragOver"
                        Drop="DropZoneBorder_Drop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="CloudArrowUp24" 
                                       FontSize="30" 
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                       Margin="0,0,12,0" 
                                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Renamer_DropTitle}" 
                                       FontWeight="SemiBold" 
                                       FontSize="13"/>
                            <TextBlock Text="{DynamicResource Renamer_DropSubtitle}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="{DynamicResource Renamer_Btn_AddFiles}" 
                                       Command="{Binding AddFilesCommand}"
                                       Appearance="Primary" 
                                       Icon="{ui:SymbolIcon Symbol=DocumentAdd24}"
                                       Margin="0,0,6,0"/>
                            <ui:Button Content="{DynamicResource Renamer_Btn_AddFolder}" 
                                       Command="{Binding AddFolderCommand}"
                                       Appearance="Secondary" 
                                       Icon="{ui:SymbolIcon Symbol=FolderAdd24}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- QUEUE STATS & SELECTION BAR -->
                <Grid Grid.Row="1" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stats Badges -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Renamer_QueueTotal}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,1" Margin="6,0,8,0">
                            <TextBlock Text="{Binding TotalCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>

                        <Border Background="#107C41" CornerRadius="10" Padding="8,1" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Renamer_StatReady}" Foreground="White" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ReadyCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#D13438" CornerRadius="10" Padding="8,1" Margin="0,0,8,0"
                                Visibility="{Binding ConflictCount, Converter={StaticResource GreaterThanZeroConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Renamer_StatConflict}" Foreground="White" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding ConflictCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#6C757D" CornerRadius="10" Padding="8,1" Margin="0,0,8,0"
                                Visibility="{Binding UnchangedCount, Converter={StaticResource GreaterThanZeroConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Renamer_StatUnchanged}" Foreground="White" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding UnchangedCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Selection Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{DynamicResource Renamer_Btn_SelectAll}" 
                                   Command="{Binding SelectAllCommand}" 
                                   Appearance="Transparent" 
                                   FontSize="11" 
                                   Padding="6,2" 
                                   Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Renamer_Btn_DeselectAll}" 
                                   Command="{Binding DeselectAllCommand}" 
                                   Appearance="Transparent" 
                                   FontSize="11" 
                                   Padding="6,2" 
                                   Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Renamer_Btn_RemoveSelected}" 
                                   Command="{Binding RemoveSelectedCommand}" 
                                   Appearance="Transparent" 
                                   Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                   FontSize="11" 
                                   Padding="6,2"/>
                    </StackPanel>
                </Grid>

                <!-- FILE LIST / PREVIEW TABLE -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6"
                        AllowDrop="True"
                        DragOver="DropZoneBorder_DragOver"
                        Drop="DropZoneBorder_Drop">
                    <Grid>
                        <!-- Empty State -->
                        <StackPanel HorizontalAlignment="Center" 
                                    VerticalAlignment="Center" 
                                    Visibility="{Binding HasItems, Converter={StaticResource BoolInverseConverter}}">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="44" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Renamer_EmptyTitle}" 
                                       FontWeight="SemiBold" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="{DynamicResource Renamer_EmptySubtitle}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Items List -->
                        <ListView ItemsSource="{Binding Items}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            Margin="0,2,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- CheckBox -->
                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsSelected}" 
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,6,0"/>

                                            <!-- Item Type Icon -->
                                            <ui:SymbolIcon Grid.Column="1" 
                                                           Symbol="Folder24" 
                                                           FontSize="16" 
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,6,0"
                                                           Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisConverter}}"/>
                                            <ui:SymbolIcon Grid.Column="1" 
                                                           Symbol="Document24" 
                                                           FontSize="16" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,6,0"
                                                           Visibility="{Binding IsDirectory, Converter={StaticResource BoolInverseConverter}}"/>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="2" 
                                                    Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}" 
                                                    CornerRadius="4" 
                                                    Padding="6,2" 
                                                    Margin="0,0,8,0" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusMessage}" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Original Name -->
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding OriginalName}" 
                                                       FontWeight="Normal" 
                                                       FontSize="11" 
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                            <!-- Arrow Separator -->
                                            <ui:SymbolIcon Grid.Column="4" 
                                                           Symbol="ArrowRight24" 
                                                           FontSize="14" 
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="6,0,6,0"/>

                                            <!-- New Name -->
                                            <TextBlock Grid.Column="5" 
                                                       Text="{Binding NewName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12" 
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <ui:Button Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                                           Appearance="Transparent" 
                                                           Padding="4" 
                                                           Margin="0,0,2,0" 
                                                           Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="{DynamicResource Renamer_Tip_OpenFolder}"/>
                                                <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                                           Appearance="Transparent" 
                                                           Padding="4" 
                                                           Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="{DynamicResource Renamer_Tip_RemoveItem}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
