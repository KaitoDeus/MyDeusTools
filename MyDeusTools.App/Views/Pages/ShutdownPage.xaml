<Page x:Class="MyDeusTools.App.Views.Pages.ShutdownPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Schedule Shutdown"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="40">
        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Shutdown_Title}" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <ui:Card Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="{DynamicResource Shutdown_Action}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ShutdownModes}" 
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <TextBlock Text="{DynamicResource Shutdown_TimeSetup}" Margin="0,0,0,15" FontWeight="SemiBold"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Shutdown_Hours}" Margin="0,0,0,5" FontSize="12"/>
                            <ui:NumberBox Value="{Binding Hours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="23" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Shutdown_Minutes}" Margin="0,0,0,5" FontSize="12"/>
                            <ui:NumberBox Value="{Binding Minutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="59" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Shutdown_Seconds}" Margin="0,0,0,5" FontSize="12"/>
                            <ui:NumberBox Value="{Binding Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="59" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Shutdown_Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" 
                                   Content="{DynamicResource Shutdown_Cancel}" 
                                   Command="{Binding CancelCommand}"
                                   Appearance="Secondary"
                                   Margin="0,0,10,0"
                                   Padding="15,8"/>

                        <ui:Button Grid.Column="2" 
                                   Content="{DynamicResource Shutdown_Start}" 
                                   Command="{Binding ScheduleCommand}"
                                   Appearance="Primary"
                                   Padding="20,8"/>
                    </Grid>

                    <TextBlock Text="{Binding CountdownText}"
                               FontSize="36"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Margin="0,15,0,5"/>
                </StackPanel>
            </ui:Card>

            <ui:InfoBar Title="{DynamicResource Shutdown_NoticeTitle}" 
                        Message="{DynamicResource Shutdown_NoticeMessage}"
                        Severity="Informational"
                        IsOpen="True" />
        </StackPanel>
    </Grid>
</Page>
