<Page x:Class="MyDeusTools.App.Views.Pages.WindowPinnerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:MyDeusTools.App.Services.Impl"
      Title="Window Pinner"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent">

    <Grid Margin="40" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="{DynamicResource WindowPinner_Title}" 
                           FontSize="28" 
                           FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="13" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Badges -->
                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                        CornerRadius="4" 
                        Padding="12,6" 
                        Margin="0,0,8,0">
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{DynamicResource WindowPinner_TotalCount}" />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </TextBlock>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                        CornerRadius="4" 
                        Padding="12,6" 
                        Margin="0,0,12,0">
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{DynamicResource WindowPinner_PinnedCount}" />
                        <Run Text="{Binding PinnedCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </TextBlock>
                </Border>

                <!-- Actions -->
                <ui:Button Content="{DynamicResource WindowPinner_PinActive}" 
                           Icon="{ui:SymbolIcon Symbol=Pin24}"
                           Command="{Binding PinForegroundWindowCommand}"
                           Appearance="Primary"
                           Padding="16,8"
                           Margin="0,0,8,0"/>

                <ui:Button Content="{DynamicResource WindowPinner_Refresh}" 
                           Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                           Command="{Binding RefreshCommand}"
                           Appearance="Secondary"
                           Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <ui:Card Grid.Row="1" Margin="0,0,0,15" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="8,0,10,0" 
                               VerticalAlignment="Center"/>

                <TextBox Grid.Column="1" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         FontSize="14" 
                         VerticalAlignment="Center"
                         Padding="4,2"/>

                <ui:Button Grid.Column="2" 
                           Content="Xóa tìm" 
                           Command="{Binding ClearSearchCommand}"
                           Appearance="Transparent"
                           Padding="10,4"
                           Margin="4,0,0,0"/>
            </Grid>
        </ui:Card>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Empty State -->
            <ui:Card HorizontalAlignment="Center" 
                     VerticalAlignment="Center" 
                     Padding="40,30" 
                     MaxWidth="460">
                <ui:Card.Style>
                    <Style TargetType="ui:Card">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWindows}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Card.Style>
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Desktop24" 
                                   FontSize="48" 
                                   HorizontalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Margin="0,0,0,15"/>
                    <TextBlock Text="{DynamicResource WindowPinner_Empty}" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource WindowPinner_Subtitle}" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="13"/>
                </StackPanel>
            </ui:Card>

            <!-- Windows List -->
            <ScrollViewer x:Name="WindowsScrollViewer"
                          HorizontalScrollBarVisibility="Disabled" 
                          VerticalScrollBarVisibility="Auto" 
                          Background="Transparent"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWindows}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding FilteredWindows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:WindowInfoModel}">
                            <ui:Card Margin="0,0,0,12" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Window Header & Actions -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Window Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <!-- Pinned Badge -->
                                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}" 
                                                        CornerRadius="4" 
                                                        Padding="6,2" 
                                                        Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Pin24" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{DynamicResource WindowPinner_Pinned}" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Window Title -->
                                                <TextBlock Text="{Binding DisplayText}" 
                                                           FontSize="15" 
                                                           FontWeight="SemiBold" 
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="520"
                                                           ToolTip="{Binding DisplayText}"/>
                                            </StackPanel>

                                            <!-- Process info -->
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="AppGeneric24" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding ProcessName, StringFormat='{}{0}'}" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ProcessId, StringFormat='{} [PID: {0}]'}" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="0,0,10,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Unpinned Button -->
                                            <Border Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ui:Button Appearance="Primary"
                                                           Padding="14,6"
                                                           ToolTip="Ghim lên trên cùng (Always on Top)"
                                                           Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Pin24" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Ghim nổi"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </Border>

                                            <!-- Pinned Button -->
                                            <Border Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ui:Button Appearance="Secondary"
                                                           Padding="14,6"
                                                           ToolTip="Bỏ ghim (Trở về bình thường)"
                                                           Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="PinOff24" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="Bỏ ghim" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </Border>

                                            <!-- Bring to Front -->
                                            <ui:Button Content="{DynamicResource WindowPinner_BringToFront}"
                                                       Icon="{ui:SymbolIcon Symbol=ArrowUp24}"
                                                       Appearance="Secondary"
                                                       Padding="12,6"
                                                       Command="{Binding DataContext.BringToFrontCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bottom Row: Opacity Controls -->
                                    <Border Grid.Row="1" 
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                            CornerRadius="6" 
                                            Padding="12,8" 
                                            Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <ui:SymbolIcon Symbol="Eye24" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{DynamicResource WindowPinner_Opacity}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                                                <TextBlock Text="{Binding OpacityPercent, StringFormat='{}{0}%'}" FontWeight="Bold" Width="42" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Slider Grid.Column="1" 
                                                    Minimum="40" 
                                                    Maximum="255" 
                                                    Focusable="False"
                                                    Value="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    VerticalAlignment="Center" 
                                                    Margin="0,0,16,0"/>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Content="100%" 
                                                           Appearance="Transparent" 
                                                           Padding="8,4" 
                                                           Margin="0,0,4,0" 
                                                           FontSize="11"
                                                           Command="{Binding DataContext.SetOpacity100Command, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="80%" 
                                                           Appearance="Transparent" 
                                                           Padding="8,4" 
                                                           Margin="0,0,4,0" 
                                                           FontSize="11"
                                                           Command="{Binding DataContext.SetOpacity80Command, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="60%" 
                                                           Appearance="Transparent" 
                                                           Padding="8,4" 
                                                           Margin="0,0,4,0" 
                                                           FontSize="11"
                                                           Command="{Binding DataContext.SetOpacity60Command, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Content="40%" 
                                                           Appearance="Transparent" 
                                                           Padding="8,4" 
                                                           Margin="0,0,4,0" 
                                                           FontSize="11"
                                                           Command="{Binding DataContext.SetOpacity40Command, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"/>
                                                <ui:Button Appearance="Transparent" 
                                                           Padding="8,4" 
                                                           ToolTip="{DynamicResource WindowPinner_ResetOpacity}"
                                                           Command="{Binding DataContext.ResetOpacityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="13"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
