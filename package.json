{
  "name": "mydeustools",
  "version": "1.0.0",
  "private": true,
  "description": "MyDeusTools - All-in-One Utility Suite (Desktop WPF, Pure Web App & OS Companion Agent)",
  "scripts": {
    "web:dev": "npm --prefix MyDeusTools.Web run dev",
    "web:build": "npm --prefix MyDeusTools.Web run build",
    "web:preview": "npm --prefix MyDeusTools.Web run preview",
    "agent:dev": "dotnet run --project MyDeusTools.Agent",
    "agent:publish": "dotnet publish MyDeusTools.Agent -c Release -o publish/agent"
  }
}
